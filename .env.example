# ========================================
# PARROTO BACKEND - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (add to .gitignore)

# ==================== ENVIRONMENT ====================
ENVIRONMENT=development
# Java services: LOG_LEVEL = root logger, APP_LOG_LEVEL = com.parroto.* (both default INFO;
# set APP_LOG_LEVEL=DEBUG when debugging the services).
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ==================== DATABASE ====================
# DB_PASSWORD = superuser "parroto". *_DB_PASSWORD = per-service roles: created by
# initdb/00-roles.sh on the FIRST start of an empty postgres volume and used by each
# service as SPRING_DATASOURCE_PASSWORD. Changing them later needs
# `docker-compose down -v` (wipes data) or a manual ALTER ROLE.
DB_PASSWORD=parroto_dev_password
AUTH_DB_PASSWORD=auth_password
CONTENT_DB_PASSWORD=content_password
PRACTICE_DB_PASSWORD=practice_password
VOCABULARY_DB_PASSWORD=vocabulary_password
SUBSCRIPTION_DB_PASSWORD=subscription_password

# ==================== JWT (REQUIRED) ====================
# Shared by api-gateway + all 5 services. REQUIRED, at least 32 characters, no fallback:
# docker-compose refuses to start without it and the services fail on boot if too short.
# The value below is a DEV-ONLY sample — generate your own:  openssl rand -base64 48
JWT_SECRET=dev-only-PnpDbPK2mcNr410ArWmM9tnxrqmI299Ip4q1b/BZa7jBdjdOky+ytEouv6wmOQwv
JWT_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=604800

# ==================== INTERNAL SERVICE TOKEN (REQUIRED) ====================
# Header X-Internal-Token for service-to-service calls on /internal/** (auth,
# subscription, vocabulary). REQUIRED, at least 32 characters. DEV-ONLY sample — generate:
#   openssl rand -hex 32
INTERNAL_TOKEN=dev-only-247832b5e523964bcac8b923ffe630977db0800683dbc216550237065c66ca63

# ==================== REDIS ====================
# api-gateway JWT blacklist. Redis down = fail-open (tokens are still accepted, WARN log).
REDIS_URL=redis://redis:6379
# Client timeout of the Java services (spring.data.redis.timeout)
REDIS_TIMEOUT=2s

# ==================== OAUTH (Optional) ====================
# Leave empty to disable: /auth/login-google and /auth/login-apple answer 503
# "chưa cấu hình" and the frontend hides the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=

# ==================== STORAGE / SPEECH MODE (mock or real) ====================
# auto (default): uses S3 when AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY are set (and do not
#                 start with "your_"), otherwise local files under MEDIA_ROOT (docker volume
#                 media_data). Uses Azure when AZURE_SPEECH_KEY is set, otherwise a
#                 deterministic mock scorer ("Chế độ demo – điểm mô phỏng").
# Force a mode with STORAGE_PROVIDER=s3|local and SPEECH_PROVIDER=azure|mock
# (forcing s3/azure without keys makes the service fail on startup).
STORAGE_PROVIDER=auto
SPEECH_PROVIDER=auto
MEDIA_ROOT=/data/media

# ==================== AWS S3 (Optional) ====================
# Lesson audio uploads + shadowing recordings. Để trống = chế độ mock (lưu file local).
S3_BUCKET=parroto-dev-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket settings (only when using real S3):
# - CORS: allow PUT (audio/wav upload) and GET from http://localhost:3000
# - Enable lifecycle: delete old audio recordings after 30 days

# ==================== AZURE SPEECH API (Optional) ====================
# Shadowing pronunciation scoring. Để trống = chế độ mock (điểm mô phỏng, không cần mạng).
# Get credentials from: https://portal.azure.com -> Cognitive Services -> Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ==================== VNPAY PAYMENT GATEWAY ====================
# Vietnam payment provider - https://vnpayment.vn

# Sandbox (development)
VNPAY_API_URL=https://sandbox.vnpayment.vn
VNPAY_API_KEY=your_vnpay_sandbox_api_key
VNPAY_SECRET=your_vnpay_sandbox_secret_key
VNPAY_MERCHANT_ID=your_vnpay_merchant_id

# Callback URL: where VNPay redirects after payment. Must point at the API Gateway's
# /subscriptions/payment-callback route (NOT a frontend page) — that endpoint verifies the
# VNPay HMAC signature and activates the subscription server-side, then 302-redirects the
# browser to FRONTEND_URL + /subscription/success or /subscription/failed.
VNPAY_RETURN_URL=http://localhost:8000/subscriptions/payment-callback

# Change to production when ready:
# VNPAY_API_URL=https://vnpayment.vn
# VNPAY_API_KEY=your_production_key
# VNPAY_SECRET=your_production_secret

# ==================== EMAIL (for Notifications) ====================
# Optional: for sending subscription confirmations, reminders, etc.
# Leave empty to disable email notifications

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@parroto.com
# Example (Gmail): MAIL_HOST=smtp.gmail.com, MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<app password>

# Gmail setup:
# 1. Enable 2FA on your Google account
# 2. Generate "App Password" at https://myaccount.google.com/apppasswords
# 3. Use that 16-character password above

# ==================== ADMIN ====================
# Comma-separated list of user emails allowed to call admin-only endpoints
# (lessons, vocabulary decks, activation codes) and to see the admin menu.
# MVP stand-in for a real roles table. Demo: register admin@parroto.com in the app.
ADMIN_EMAILS=admin@parroto.com
# The single admin account, created by auth-service on startup if it does not exist.
# ADMIN_EMAIL must be listed in ADMIN_EMAILS. Password: at least 12 characters.
# ADMIN_PASSWORD_RESET=true overwrites the existing account's password on the next start
# (use once to recover access, then set it back to false).
ADMIN_EMAIL=admin@parroto.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=false

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost:3000

# Set in production:
# FRONTEND_URL=https://parroto.com

# ==================== MICROSERVICES ====================
# Internal URLs for service-to-service communication
AUTH_SERVICE_URL=http://auth-service:8001
CONTENT_SERVICE_URL=http://content-service:8002
PRACTICE_SERVICE_URL=http://practice-service:8003
VOCABULARY_SERVICE_URL=http://vocabulary-service:8004
SUBSCRIPTION_SERVICE_URL=http://subscription-service:8005

# ==================== MONITORING & LOGGING ====================
# Optional: for Datadog, Sentry, or other monitoring services

SENTRY_DSN=
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# ==================== DEVELOPMENT ONLY ====================
# Enable debug mode, verbose logging, etc.

DEBUG=true
ALLOW_INSECURE_TLS=false
ENABLE_PROFILING=false

# ========================================
# QUICK START
# ========================================
# 1. Copy this file: cp .env.example .env
# 2. Replace JWT_SECRET and INTERNAL_TOKEN with your own random values (see above).
#    Everything else works as-is in demo/mock mode (no AWS/Azure/Google keys needed).
# 3. Start services: docker-compose up -d --build
# 4. Check logs: docker-compose logs -f api-gateway
# 5. Test API: curl http://localhost:8000/health

# ========================================
# PRODUCTION CHECKLIST
# ========================================
# [ ] Change ENVIRONMENT=production
# [ ] Use strong JWT_SECRET (min 32 characters)
# [ ] Set real AWS S3 bucket with encryption
# [ ] Use production VNPAY credentials
# [ ] Enable email notifications
# [ ] Configure HTTPS/SSL
# [ ] Set up monitoring & alerting
# [ ] Enable database backups
# [ ] Use managed database (RDS) instead of Docker Postgres
# [ ] Use managed Redis (ElastiCache) instead of Docker Redis
# [ ] Configure CDN for audio/video files
# [ ] Set up CI/CD pipeline with GitHub Actions
# [ ] Enable rate limiting & DDoS protection
# [ ] Configure firewall rules
# [ ] Set up WAF (Web Application Firewall)
# [ ] Enable CORS only for trusted frontend URL
# [ ] Rotate secrets monthly
# [ ] Monitor error rates & performance metrics
