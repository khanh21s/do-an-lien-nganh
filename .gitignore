# Environment
.env
.env.local
.env.prod
.env.staging

# Java / Maven
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/

# Node
node_modules/
npm-debug.log*
dist/
.next/

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Docker volumes (local dev data, not meant to be committed)
postgres_data/
redis_data/

# TypeScript incremental build info (regenerated by tsc --noEmit)
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Local docker-compose overrides (copy of docker-compose.override.yml.example)
docker-compose.override.yml

# Local media storage (mock mode) - only the generated seed audio is committed
media/*
!media/seed/

# Temp dir of scripts/gen-seed-audio.sh
.seed-audio-work.*/
