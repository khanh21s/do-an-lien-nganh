{
  "name": "parroto-api-gateway",
  "version": "1.0.0",
  "description": "Parroto API Gateway - routes, authenticates, and rate-limits requests to the backend microservices",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.19.2",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "http-proxy-middleware": "2.0.6",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "redis": "4.6.14",
    "uuid": "9.0.1"
  },
  "engines": {
    "node": ">=20"
  }
